#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode -L /usr/share/wrthub /usr/share/wrthub/wrthub-agent.uc
	procd_set_param file /etc/config/wrthub
	procd_set_param file /etc/wrthub/token
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
